<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="jamsys">
  <enum id="org.gnome.shell.extensions.jamsys.position">
    <value nick="top-left" value="0"/>
    <value nick="top-center" value="1"/>
    <value nick="top-right" value="2"/>
    <value nick="bottom-left" value="3"/>
    <value nick="bottom-right" value="4"/>
  </enum>
  <enum id="org.gnome.shell.extensions.jamsys.mode">
    <value nick="compact" value="0"/>
    <value nick="minimal" value="1"/>
    <value nick="cluster" value="2"/>
  </enum>
  <schema id="org.gnome.shell.extensions.jamsys"
          path="/org/gnome/shell/extensions/jamsys/">
    <key name="position" enum="org.gnome.shell.extensions.jamsys.position">
      <default>'top-right'</default>
      <summary>Where the readout sits</summary>
    </key>
    <key name="mode" enum="org.gnome.shell.extensions.jamsys.mode">
      <default>'cluster'</default>
      <summary>Instrument cluster, compact single line, or minimal multi-line</summary>
    </key>
    <key name="scale" type="d">
      <default>1.0</default>
      <range min="0.55" max="1.8"/>
      <summary>Size of the instrument cluster</summary>
    </key>
    <key name="opacity" type="d">
      <default>0.92</default>
      <range min="0.35" max="1.0"/>
      <summary>Opacity of the cluster housing</summary>
    </key>
    <key name="margin" type="i">
      <default>14</default>
      <range min="0" max="120"/>
      <summary>Distance from the screen edge, in pixels</summary>
    </key>
    <key name="show-cpu" type="b"><default>true</default><summary>Show CPU</summary></key>
    <key name="show-temp" type="b"><default>true</default><summary>Show CPU temperature</summary></key>
    <key name="show-ram" type="b"><default>true</default><summary>Show memory</summary></key>
    <key name="show-gpu" type="b"><default>true</default><summary>Show GPU</summary></key>
    <key name="show-power" type="b"><default>true</default><summary>Show power draw</summary></key>
    <key name="show-net" type="b"><default>true</default><summary>Show network</summary></key>
    <key name="dim-when-healthy" type="b">
      <default>true</default>
      <summary>Fade the readout into the panel while everything is normal</summary>
    </key>
  </schema>
</schemalist>
