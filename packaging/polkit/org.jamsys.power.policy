<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>JamSys</vendor>
  <vendor_url>https://example.invalid/jamsys</vendor_url>

  <action id="org.jamsys.power.charge-limit">
    <description>Change the battery charge limit</description>
    <message>Authentication is required to change the battery charge limit</message>
    <icon_name>battery</icon_name>

    <!--
      auth_admin_keep, deliberately stricter than the keyboard action.

      Keyboard colour is cosmetic and is changed constantly, so prompting there would
      be user-hostile. A charge limit is neither: it is set rarely, it changes how the
      machine treats its battery, and a limit silently dropped to 20% would be a
      genuinely unpleasant surprise. So it asks once and remembers for a few minutes.

      The privilege granted remains narrow by construction: the helper writes exactly
      one attribute name, on one of three compile-time battery paths, with an integer
      validated to 20-100 before anything is opened. It cannot be given a path.
      See docs/privilege-model.md.
    -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/jamsys-power</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
