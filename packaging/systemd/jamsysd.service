[Unit]
Description=JamSys system-health monitor
Documentation=file:///usr/share/doc/jamsys/README.md
# Wait for the graphical session so desktop notifications have a bus to reach.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/jamsysd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
# A monitor must never become the problem it is watching for.
Nice=5
IOSchedulingClass=idle
CPUWeight=20
MemoryMax=256M
TasksMax=32

# Hardening. This is a user unit, so it already has no privileges to drop; these
# further reduce what a compromised daemon could reach.
#
# Deliberately absent: PrivateTmp, ProtectSystem, ProtectHome, ReadWritePaths,
# ProtectKernelTunables and ProtectControlGroups. Each needs a mount namespace,
# which an unprivileged user manager can only get by first putting the service
# in a *user* namespace. Measured on Ubuntu 26.04 with
# kernel.apparmor_restrict_unprivileged_userns=1: the user namespace was created
# and the mount namespace was not, so none of the six protected anything (/ was
# still writable) -- while from inside that namespace the kernel refuses
# /proc/<pid>/io and /proc/<pid>/fdinfo for every process but our own. The price
# of protection that was not there was every per-process I/O and GPU figure
# reading zero. Everything below is seccomp or a prctl and needs no namespace.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The daemon connects to the gateway/DNS for reachability checks (no payload sent);
# set RestrictAddressFamilies to AF_UNIX AF_NETLINK only if you disable that feature.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=graphical-session.target
